<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DW26" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/dw_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/dw_sky</item>
        <item name="colorOnPrimaryContainer">@color/dw_navy</item>
        <item name="colorSecondaryContainer">@color/dw_sky</item>
        <item name="colorOnSecondaryContainer">@color/dw_navy</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:colorBackground">@color/dw_bg</item>
        <item name="android:statusBarColor">@color/dw_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="DW" />

    <style name="DW.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="DW.Label">
        <item name="android:textColor">@color/dw_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DW.Value">
        <item name="android:textColor">@color/dw_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DW.Section">
        <item name="android:textColor">@color/dw_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
